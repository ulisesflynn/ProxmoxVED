# Default container settings for iDRAC-CertMgr
#
# Placed at defaults/idrac-certmgr.vars in your fork, these values pre-fill the
# container-creation wizard (the "Default values" path) so you don't retype them.
# Edit any line to taste; the wizard still lets you override at create time.

var_cpu=1
var_ram=512
var_disk=4
var_os=debian
var_version=12
var_unprivileged=1
var_hostname=idrac-certmgr
var_tags=network;certificates

# Timezone matters here: it controls when acme.sh's daily renewal cron and the
# 06:30 healthcheck actually fire. Set it to your locale.
var_timezone=America/Denver
